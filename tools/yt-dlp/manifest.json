  "music": {
    "adapter": "upstream go-music-dl music-lib compiled to a lazy WebAssembly worker; browser requests use the Cloudflare music relay",
    "upstream": "https://github.com/guohuiyuan/go-music-dl",
    "configurableSources": [
      "netease",
      "qq",
      "kugou",
      "kuwo",
      "migu",
      "bilibili",
      "soda",
      "joox",
      "qianqian",
      "5sing",
      "jamendo",
      "apple",
      "spotify"
    ],
    "features": [
      "song search and pagination",
      "public Netease playlist/album search and collection details",
      "Apple Music preview search and albums",
      "public charts and playlist categories",
      "audio playback, timeline, loop modes, media-session shortcuts",
      "timed LRC display",
      "matched source switching with URL probe",
      "batch queue, stop/retry, validated HTTP Range resume when supported",
      "IndexedDB local library with editable tags, lyrics and cover",
      "MP3/WAV/FLAC conversion using local shared FFmpeg WASM",
      "original audio stream copy when adding metadata",
      "MP3 standard USLT lyrics and front cover embedding",
      "favorites and playlist CRUD, JSON import/export",
      "filename templates and optional directory selection",
      "direct WebDAV PUT; requires server CORS permission; session-only credentials",
      "native music-lib provider search for 13 sources",
      "native playlist and album search/details",
      "native lyrics, quality resolution and link parsing",
      "session-only platform Cookie and QR login for supported providers",
      "native source playback and resumable downloads through the music relay",
      "corresponding music-lib source embedded in the WASM custom section pocket.sources"
    ],
    "limitations": [
      "Provider access still depends on upstream availability, login state, copyright and anti-bot controls.",
      "Soda native signing may require its official client signer; Spotify may return preview-only tracks.",
      "The original Go server TUI and AI HTTP/SSE server are not started in a static page; browser-native search, login, playback, conversion and download paths are included."
    ],
    "relay": "https://pocket-toolbox-media.pages.dev/music/fetch"
  }
}
