  "music": {
    "adapter": "browser implementation inspired by go-music-dl; does not execute the original Go server",
    "upstream": "https://github.com/guohuiyuan/go-music-dl",
    "configurableSources": [
      "netease",
      "qq",
      "kugou",
      "kuwo",
      "migu",
      "bilibili",
      "soda",
      "joox",
      "qianqian",
      "5sing",
      "jamendo",
      "apple",
      "spotify"
    ],
    "features": [
      "song search and pagination",
      "public Netease playlist/album search and collection details",
      "Apple Music preview search and albums",
      "public charts and playlist categories",
      "audio playback, timeline, loop modes, media-session shortcuts",
      "timed LRC display",
      "matched source switching with URL probe",
      "batch queue, stop/retry, validated HTTP Range resume when supported",
      "IndexedDB local library with editable tags, lyrics and cover",
      "MP3/WAV/FLAC conversion using local shared FFmpeg WASM",
      "original audio stream copy when adding metadata",
      "MP3 standard USLT lyrics and front cover embedding",
      "favorites and playlist CRUD, JSON import/export",
      "filename templates and optional directory selection",
      "direct WebDAV PUT; requires server CORS permission; session-only credentials"
    ],
    "limitations": [
      "Account/QR login, authenticated platform libraries and native TUI/system integration are not implemented in the static browser adaptation.",
      "Original go-music-dl AI HTTP/SSE server is not included.",
      "Public source availability depends on third-party APIs and platform authorization; some sources require a custom compatible API.",
      "Apple Music results contain preview clips rather than full tracks.",
      "HTTP Range resume is within the current page session and requires a readable strong ETag or Last-Modified validator."
    ]
  }
}
