{
  "name": "toolbox-python-ide",
  "version": "1.0.0",
  "entry": "tools/python-ide/",
  "license": "MIT; third-party original licenses retained",
  "runtime": {
    "engine": "Pyodide",
    "version": "314.0.6",
    "python": "3.14",
    "sharedPath": "vendor/pyodide/",
    "source": "https://github.com/pyodide/pyodide",
    "license": "vendor/pyodide/LICENSE",
    "manifest": "licenses/jupyter-manifest.json"
  },
  "build": "npm ci && npm run build && npm run package-source",
  "test": "npm test (Playwright real Chrome; static site at http://127.0.0.1:8765)",
  "features": [
    "real CPython WASM",
    "CodeMirror Python editing",
    "compile/run stdout/stderr",
    "pre-filled linewise stdin",
    "Worker terminate stop/reset",
    "UTF-8 and binary file import/export",
    "JSON project import/export",
    "IndexedDB corruption/conflict protection",
    "responsive no root scrolling"
  ],
  "limits": {
    "projectBytes": 8388608,
    "fileBytes": 4194304,
    "fileCount": 128,
    "stdoutCharacters": 100000
  },
