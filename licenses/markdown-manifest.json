{
  "name": "toolbox-markdown",
  "version": "1.0.0",
  "entry": "tools/markdown/",
  "license": "MIT; third-party notices included",
  "build": "npm ci && npm run build && npm run package-source",
  "supports": [
    "CodeMirror 6 editing",
    "GFM preview",
    "syntax highlight",
    "toolbar and keyboard shortcuts",
    "UTF-8 md/txt import",
    "Markdown and self-contained HTML export",
    "browser print/PDF",
    "IndexedDB local draft with corruption protection",
    "desktop split and mobile tabs"
  ],
  "security": {
    "rawHTML": false,
    "remoteImages": "off by default; explicit session-only HTTP(S) opt-in",
    "htmlExport": "sanitized with embedded styles, no scripts or remote images"
  },
